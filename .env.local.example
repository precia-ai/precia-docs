# Copy this file to .env.local (gitignored, never commit real values).
# Used by scripts/screenshots/* to log in as each demo role when capturing
# documentation screenshots against https://app-dev.precia.site.

PRECIA_BASE_URL=https://app-dev.precia.site

# One EMAIL/PASSWORD pair per demo role created by
# `python manage.py seed_demo_accounts` in precia-be.
PRECIA_DEMO_NRS_EMAIL=
PRECIA_DEMO_NRS_PASSWORD=
PRECIA_DEMO_CLN_EMAIL=
PRECIA_DEMO_CLN_PASSWORD=
PRECIA_DEMO_CVL_EMAIL=
PRECIA_DEMO_CVL_PASSWORD=
PRECIA_DEMO_CAD_EMAIL=
PRECIA_DEMO_CAD_PASSWORD=
PRECIA_DEMO_MGT_EMAIL=
PRECIA_DEMO_MGT_PASSWORD=
PRECIA_DEMO_AUD_EMAIL=
PRECIA_DEMO_AUD_PASSWORD=
PRECIA_DEMO_SAD_EMAIL=
PRECIA_DEMO_SAD_PASSWORD=
PRECIA_DEMO_PAD_EMAIL=
PRECIA_DEMO_PAD_PASSWORD=
PRECIA_DEMO_IAD_EMAIL=
PRECIA_DEMO_IAD_PASSWORD=
PRECIA_DEMO_AIE_EMAIL=
PRECIA_DEMO_AIE_PASSWORD=
PRECIA_DEMO_CARE_EMAIL=
PRECIA_DEMO_CARE_PASSWORD=

# Akun staf CARE (ohcnetwork) pada https://care-dev.precia.site, dipakai oleh
# scripts/screenshots/pages/integrasi-simrs__care.config.js. CARE membatasi
# login menjadi lima kali per sepuluh menit per nama pengguna, sehingga spec
# tersebut mengambil satu sesi lewat API lalu memakainya ulang.
CARE_DEMO_USERNAME=
CARE_DEMO_PASSWORD=

# Demo viewer inside the organisation "RS Uji Coba CARE", used by the
# integrasi-simrs__care specs. The other demo roles resolve to the platform
# super administrator, whose clinical queries are scoped to a different
# organisation and cannot read the Radiologi worklist.
PRECIA_DEMO_CARE_EMAIL=
PRECIA_DEMO_CARE_PASSWORD=

# Demo clinician on the CARE (ohcnetwork) instance at care-dev.precia.site.
# Used only by the integrasi-simrs__care specs, which screenshot the CARE web
# interface directly. CARE is a separate system, so these are not PRECIA
# credentials and no PRECIA role code applies.
CARE_DEMO_USERNAME=
CARE_DEMO_PASSWORD=
