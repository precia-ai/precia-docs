# Copy this file to .env.local (gitignored, never commit real values).
# Used by scripts/screenshots/* to log in as each demo role when capturing
# documentation screenshots against https://app-dev.precia.site.

PRECIA_BASE_URL=https://app-dev.precia.site

# One EMAIL/PASSWORD pair per demo role created by
# `python manage.py seed_demo_accounts` in precia-be.
PRECIA_DEMO_NRS_EMAIL=
PRECIA_DEMO_NRS_PASSWORD=
PRECIA_DEMO_CLN_EMAIL=
PRECIA_DEMO_CLN_PASSWORD=
PRECIA_DEMO_CVL_EMAIL=
PRECIA_DEMO_CVL_PASSWORD=
PRECIA_DEMO_CAD_EMAIL=
PRECIA_DEMO_CAD_PASSWORD=
PRECIA_DEMO_MGT_EMAIL=
PRECIA_DEMO_MGT_PASSWORD=
PRECIA_DEMO_AUD_EMAIL=
PRECIA_DEMO_AUD_PASSWORD=
PRECIA_DEMO_SAD_EMAIL=
PRECIA_DEMO_SAD_PASSWORD=
PRECIA_DEMO_PAD_EMAIL=
PRECIA_DEMO_PAD_PASSWORD=
PRECIA_DEMO_IAD_EMAIL=
PRECIA_DEMO_IAD_PASSWORD=
PRECIA_DEMO_AIE_EMAIL=
PRECIA_DEMO_AIE_PASSWORD=

# SIMRS Khanza (scripts/screenshots/pages/integrasi-simrs__khanza*.config.js).
# Klien operator Khanza disajikan lewat noVNC pada KHANZA_UI_URL; kredensial
# di bawah masuk ke klien Swing tersebut.
KHANZA_UI_URL=
KHANZA_UI_USER=
KHANZA_UI_PASSWORD=
# Portal web terpisah (webapps/preciahasil.php) tempat hasil AI ditarik
# kembali ke Khanza. BELUM DIKONFIRMASI ke tim infrastruktur; isi setelah
# alamat sesungguhnya diketahui. Langkah 08/09 pada
# integrasi-simrs__khanza.config.js memakai variabel ini.
KHANZA_WEBAPPS_URL=
# no_rawat kasus yang dipakai untuk memverifikasi langkah 09. Pakai kasus
# yang statusnya sudah Selesai di PRECIA supaya precia_result_in di staging
# Khanza sudah berisi baris hasil.
KHANZA_RESULT_NO_RAWAT=

# Akun PRECIA yang berada DI DALAM organisasi tenant MEDICCA (bukan organisasi
# platform). Dipakai oleh
# scripts/screenshots/pages/integrasi-simrs__medicca.config.js untuk dua
# tangkapan layar sisi PRECIA, supaya yang tampil adalah unit dan daftar kerja
# transaksi milik tenant MEDICCA, bukan milik organisasi lain.
PRECIA_DEMO_MDOC_EMAIL=
PRECIA_DEMO_MDOC_PASSWORD=

# --- SIMRS MEDICCA (dev) ---
# Used by scripts/screenshots/pages/integrasi-simrs__medicca.config.js
# to capture the MEDICCA operator screens. The operator account is created
# inside MEDICCA itself (PENGATURAN > PETUGAS LOKET), not in PRECIA. The
# administrator account is the built-in one defined in the MEDICCA
# application configuration; it is only used for the two prerequisite steps.
MEDICCA_BASE_URL=https://medicca-dev.precia.site
MEDICCA_ADMIN_USERNAME=
MEDICCA_ADMIN_PASSWORD=
MEDICCA_OPERATOR_USERNAME=
MEDICCA_OPERATOR_PASSWORD=

# Extra PRECIA demo account used only by
# scripts/screenshots/pages/integrasi-simrs__bahmni.config.js. It belongs to the
# organization that receives the transactions produced from Bahmni, which the
# other demo accounts cannot see.
PRECIA_DEMO_BAHMNI_EMAIL=
PRECIA_DEMO_BAHMNI_PASSWORD=

# Bahmni EMR demo account, also used only by the Bahmni screenshot specs.
# BAHMNI_DEMO_LOCATION must match one of the entries in the Location dropdown on
# the Bahmni login page.
BAHMNI_BASE_URL=https://bahmni-dev.precia.site
BAHMNI_DEMO_USER=
BAHMNI_DEMO_PASSWORD=
BAHMNI_DEMO_LOCATION=Bahmni Clinic

# Akun demo PRECIA di dalam organisasi "RS Uji Coba CARE", dipakai oleh
# scripts/screenshots/pages/integrasi-simrs__care.config.js. Peran demo lain
# teresolusi ke super administrator platform, yang kueri klinisnya tercakup
# pada organisasi berbeda dan tidak dapat membaca daftar kerja Radiologi.
PRECIA_DEMO_CARE_EMAIL=
PRECIA_DEMO_CARE_PASSWORD=

# Akun staf CARE (ohcnetwork) pada https://care-dev.precia.site, dipakai hanya
# oleh spec integrasi-simrs__care yang menangkap antarmuka CARE secara
# langsung. CARE adalah sistem terpisah, sehingga ini bukan kredensial PRECIA
# dan tidak ada kode peran PRECIA yang berlaku. CARE membatasi login menjadi
# lima kali per sepuluh menit per nama pengguna, sehingga spec tersebut
# mengambil satu sesi lewat API lalu memakainya ulang.
CARE_DEMO_USERNAME=
CARE_DEMO_PASSWORD=

# --- SIMRS OpenMRS 3 (O3 Reference Application, dev) ---
# Akun staf OpenMRS 3 pada https://openmrs-dev.precia.site, dipakai oleh
# scripts/screenshots/pages/integrasi-simrs__openmrs.config.js untuk sisi
# OpenMRS (spec 01-12 dan 18). Bukan kredensial PRECIA, tidak ada kode peran
# PRECIA yang berlaku di sini.
OPENMRS_DEMO_USERNAME=
OPENMRS_DEMO_PASSWORD=

# Akun demo PRECIA di dalam organisasi "RS Uji Coba OpenMRS 3", dipakai oleh
# scripts/screenshots/pages/integrasi-simrs__openmrs.config.js untuk sisi
# PRECIA (spec 13-17). Peran demo lain teresolusi ke super administrator
# platform, yang organisasinya berbeda dan tidak dapat membaca daftar kerja
# maupun transaksi milik organisasi OpenMRS 3, sama seperti kasus CARE,
# Bahmni dan GNU Health di atas.
PRECIA_DEMO_OPENMRS3_EMAIL=
PRECIA_DEMO_OPENMRS3_PASSWORD=

# Akun demo PRECIA di dalam organisasi "RS Uji Coba Open Hospital" (dev),
# dipakai oleh scripts/screenshots/pages/integrasi-simrs__openhospital.config.js
# untuk dua tangkapan layar sisi PRECIA (langkah 01 dan 06). Peran demo lain
# teresolusi ke organisasi berbeda dan tidak dapat membaca daftar kerja
# validasi milik tenant Open Hospital.
PRECIA_DEMO_OPENHOSPITAL_EMAIL=
PRECIA_DEMO_OPENHOSPITAL_PASSWORD=

# Akun Open Hospital dev, dipakai oleh
# scripts/screenshots/pages/integrasi-simrs__openhospital.config.js untuk
# login ke antarmuka web (langkah 02-05 dan 07) DAN oleh
# scripts/screenshots/oh-roundtrip-api-evidence.js untuk membaca
# GET /precia-integration/ai-results/{sourceType}/{sourceCode} setelah
# validasi dipublikasikan di PRECIA. Bukan kredensial PRECIA, dan bukan akun
# baca konektor (akun baca konektor tidak memegang izin
# precia_integration.callback).
OH_BASE_URL=https://openhospital-dev.precia.site
OH_USERNAME=
OH_PASSWORD=

# Dipakai scripts/screenshots/pages/integrasi-simrs__openemr.config.js.
# OPENEMR_USER/PASSWORD adalah akun admin OpenEMR pada server dev (kredensial
# Jenkins openemr-admin). PRECIA_DEMO_OED_EMAIL/PASSWORD adalah akun PRECIA
# pada organisasi "RS Uji Coba OpenEMR", perlu peran CAD supaya dapat membaca
# semua unit saat memotret layar daftar kasus/detail kasus.
OPENEMR_USER=
OPENEMR_PASSWORD=
PRECIA_DEMO_OED_EMAIL=
PRECIA_DEMO_OED_PASSWORD=
